#!/bin/bash
# reapply-darkmode — re-applies the terminal-browser dark-mode patch.
#
# Usage:  reapply-darkmode [path-to-main.js]
#   Default path: ~/.local/share/terminal-browser/app/browser/dist/main.js
#   Run again after `terminal-browser upgrade` (which resets the bundled JS).
#   Safe to run multiple times — skips when already patched.
set -euo pipefail

F="${1:-$HOME/.local/share/terminal-browser/app/browser/dist/main.js}"

if [ ! -f "$F" ]; then
  echo "error: $F not found (is terminal-browser installed?)" >&2
  exit 1
fi

node --check "$F" 2>/dev/null || { echo "error: $F is not valid JS — aborting" >&2; exit 1; }

if grep -q 'setAutoDarkModeOverride' "$F"; then
  echo "already patched; nothing to do."
  exit 0
fi

node -e '
const fs = require("fs");
const f = process.argv[1];
let s = fs.readFileSync(f, "utf8");

const newImpl = `async emulateColorScheme() {
        if (!this.cdpAttached)
          return;
        // [darkmode patch] always request dark: sites with a dark stylesheet use
        // it, and auto-dark mode darkens light-only pages too.
        await this.cdp("Emulation.setEmulatedMedia", {
          features: [{ name: "prefers-color-scheme", value: "dark" }]
        });
        await this.cdp("Emulation.setAutoDarkModeOverride", { enabled: true });
      }`;

// 1) exact original implementation (current stable v0.11.1)
const oldImpl = `async emulateColorScheme() {
        if (!this.cdpAttached)
          return;
        const n = parseInt(this.background.slice(1), 16);
        const [r, g, b] = [n >> 16 & 255, n >> 8 & 255, n & 255];
        const dark = 0.2126 * r + 0.7152 * g + 0.0722 * b < 128;
        await this.cdp("Emulation.setEmulatedMedia", {
          features: [{ name: "prefers-color-scheme", value: dark ? "dark" : "light" }]
        });
      }`;

let applied = false;
if (s.includes(oldImpl)) {
  s = s.replace(oldImpl, newImpl);
  applied = true;
} else {
  // 2) fallback for slightly changed bundles: force the scheme to dark…
  const v = `value: dark ? "dark" : "light"`;
  if (s.includes(v)) { s = s.split(v).join(`value: "dark"`); applied = true; }
  // …and insert the auto-dark override right after the setEmulatedMedia call.
  const target = `features: [{ name: "prefers-color-scheme", value: "dark" }]\n        });`;
  if (s.includes(target) && !s.includes("setAutoDarkModeOverride")) {
    s = s.split(target).join(target + `\n        await this.cdp("Emulation.setAutoDarkModeOverride", { enabled: true });`);
    applied = true;
  }
}

if (!applied) {
  console.error("error: could not locate emulateColorScheme in this build — the file may have changed after an upgrade; send the new snippet for a fresh patch");
  process.exit(1);
}

fs.writeFileSync(f, s);
console.log("patched: dark mode enforced");
' -- "$F"

node --check "$F" 2>/dev/null || { echo "error: patch produced invalid JS — restoring is on you, sorry; send me the file" >&2; exit 1; }
echo "syntax ok"