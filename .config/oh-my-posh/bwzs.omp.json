{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "background": "#FFFFFF",
          "foreground": "#000000",
          "leading_diamond": "",
          "style": "diamond",
          "template": "{{ .UserName }} ",
          "type": "session"
        },
        {
          "background": "#CCCCCC",
          "foreground": "#000000",
          "powerline_symbol": "",
          "options": {
            "style": "folder"
          },
          "style": "powerline",
          "template": " {{ .Path }} ",
          "type": "path"
        },
        {
          "background": "#777777",
          "foreground": "#FFFFFF",
          "powerline_symbol": "",
          "options": {
            "branch_icon": ""
          },
          "style": "powerline",
          "template": "  ({{ .UpstreamIcon }}{{ .HEAD }}{{ if gt .StashCount 0 }}  {{ .StashCount }}{{ end }}) ",
          "type": "git"
        },
        {
          "background": "#444444",
          "foreground": "#FFFFFF",
          "powerline_symbol": "",
          "style": "powerline",
          "template": "  {{ if .PackageManagerIcon }}{{ .PackageManagerIcon }} {{ end }}{{ .Full }} ",
          "type": "node"
        },
        {
          "background": "#ff0000",
          "foreground": "#000000",
          "options": {
            "time_format": "15:04"
          },
          "style": "diamond",
          "template": " ♥ {{ .CurrentDate | date .Format }} ",
          "trailing_diamond": "",
          "type": "time"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "segments": [
        {
          "background": "#FFFFFF",
          "foreground": "#000000",
          "invert_powerline": true,
          "leading_diamond": "",
          "style": "diamond",
          "template": " {{.Profile}}{{if .Region}}@{{.Region}}{{end}}",
          "trailing_diamond": "",
          "type": "aws"
        }
      ],
      "type": "rprompt"
    }
  ],
  "final_space": true,
  "version": 4
}